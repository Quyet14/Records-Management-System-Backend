{
  "name": "lths-backend",
  "version": "1.0.0",
  "description": "Backend cho hệ thống lưu trữ PDF kỹ số (NestJS + MySQL + TypeORM)",
  "scripts": {
    "test:security": "npm run build && node scripts/test-security.cjs",
    "db:add-security": "node scripts/apply-security-migration.cjs --apply",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "data:import-mysql": "node scripts/data-pipeline.js import-mysql-dump",
    "data:index-files": "node scripts/data-pipeline.js index-files",
    "data:migrate-sqlserver": "node scripts/data-pipeline.js migrate-sqlserver",
    "data:backup-sync": "node scripts/data-pipeline.js backup-sync",
    "data:all": "node scripts/data-pipeline.js all",
    "db:add-user-permissions": "node scripts/apply-user-permissions-migration.js",
    "db:add-document-metadata": "node scripts/apply-document-metadata-migration.js",
    "db:add-destruction": "node scripts/apply-destruction-migration.cjs --apply",
    "db:repair-destruction": "node scripts/apply-destruction-migration.cjs --apply --repair",
    "db:add-auth-sessions": "node scripts/apply-auth-sessions-migration.cjs --apply",
    "test:auth-sessions": "npm run build && node scripts/test-auth-sessions.cjs",
    "test:destruction": "npm run build && node scripts/test-destruction.cjs",
    "destruction:check": "node scripts/check-destruction.cjs",
    "destruction:init": "node scripts/check-destruction.cjs --init",
    "test:destruction-local": "npm run build && node scripts/test-destruction-local.cjs && node scripts/test-destruction-restore.cjs && node scripts/test-destruction-defender.cjs",
    "user:reset-password": "node reset-password.js",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "helmet": "^8.3.0",
    "mssql": "^12.7.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.1",
    "nodemailer": "6.9.16",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "0.15.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.16",
    "@types/nodemailer": "6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "0.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.3.3"
  }
}
